# Settings for the scripts in examples/. Copy this file to .env (which git
# ignores) and run `uv run --env-file .env python examples/judge_quickstart.py`,
# or export the variables in your shell.
#
# Canary itself reads none of these. Provider SDKs read their own API keys,
# and JUDGE_* are settings of the example application. Keep keys commented out
# until you use them: an empty ANTHROPIC_API_KEY would shadow an
# `ant auth login` profile.

# Which example port to run: fake (offline, the default), anthropic, or openai.
JUDGE_PROVIDER=fake

# Model for the chosen provider. The Anthropic example defaults to
# claude-opus-5; the OpenAI example requires a model with structured outputs.
# JUDGE_MODEL=

# Read by the Anthropic SDK (or use `ant auth login` instead of a key).
# ANTHROPIC_API_KEY=

# Read by the OpenAI SDK.
# OPENAI_API_KEY=
